flowchart TB
  classDef ink fill:#14263E,color:#FFFFFF,stroke:#14263E,stroke-width:2px
  classDef teal fill:#DCF2EE,color:#173F43,stroke:#25877F,stroke-width:1.6px
  classDef blue fill:#E9ECFA,color:#29345E,stroke:#6873AF,stroke-width:1.6px
  classDef gold fill:#FFF2D8,color:#654D20,stroke:#C39A50,stroke-width:1.6px
  classDef muted fill:#F3F5F7,color:#475569,stroke:#94A3B8,stroke-dasharray:5 4
  subgraph INPUT["File preparation"]
    direction LR
    A["CSV / XLSX<br/>Map text and optional labels"]:::ink --> B["Validate labels and language<br/>Select declared test rows"]:::blue --> C["Resolve compatible model<br/>Explicit fallback only"]:::teal
  end
  subgraph INFER["Batch prediction"]
    direction LR
    D["Predict selected rows<br/>Keep original row order"]:::ink --> E["Record actual source<br/>Seven scores + truncation"]:::teal --> F["Check training overlap<br/>Retain data origin notices"]:::gold
  end
  subgraph REPORT["Evaluation outputs"]
    direction LR
    G["Labels supplied<br/>Accuracy, macro-F1, class scores"]:::blue
    H["No labels supplied<br/>Predictions only; no accuracy"]:::gold
    I["Download row predictions<br/>JSON evaluation + language slices"]:::teal
    G --> I
    H --> I
  end
  INPUT --> INFER --> REPORT
