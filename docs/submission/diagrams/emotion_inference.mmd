flowchart TB
  classDef ink fill:#14263E,color:#FFFFFF,stroke:#14263E,stroke-width:2px
  classDef teal fill:#DCF2EE,color:#173F43,stroke:#25877F,stroke-width:1.6px
  classDef blue fill:#E9ECFA,color:#29345E,stroke:#6873AF,stroke-width:1.6px
  classDef gold fill:#FFF2D8,color:#654D20,stroke:#C39A50,stroke-width:1.6px
  classDef muted fill:#F3F5F7,color:#475569,stroke:#94A3B8,stroke-dasharray:5 4
  subgraph PREP["Input preparation"]
    direction LR
    A["Phrase + optional emoji<br/>Selected language mix"]:::ink --> B["Verify compatible checkpoint<br/>Seven labels and metadata"]:::blue --> C["Prepare and tokenize<br/>Saved mode; token limit 128"]:::teal
  end
  subgraph PREDICT["Selected encoder"]
    direction LR
    D["XLM-R / MuRIL<br/>mBERT after training"]:::ink --> E["Contextual representation<br/>Seven-class task head"]:::blue --> F["Seven base scores<br/>Top emotion and source"]:::teal
  end
  subgraph DISPLAY["Result interpretation"]
    direction LR
    G["Scope + truncation notices<br/>Score/margin uncertainty"]:::gold --> H["Optional Qwen suggestion<br/>Base scores unchanged"]:::muted --> I["Emotion chart + diagnostics<br/>Explicit session export"]:::teal
  end
  PREP --> PREDICT --> DISPLAY
