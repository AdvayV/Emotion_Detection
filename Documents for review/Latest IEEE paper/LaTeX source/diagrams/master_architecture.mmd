flowchart TB
  subgraph DATA[" "]
    direction LR
    SOURCE["Generated or reviewed data"] --> SPLITS["Frozen train, validation and test"] --> GPU["Colab / Kaggle GPU; selected checkpoint export"]
  end
  subgraph INPUT[" "]
    direction LR
    FILE["Phrase or CSV / XLSX"] --> TASK["Separate sentiment or emotion task"] --> MODELS["Original / combined XLM-R, mBERT, MuRIL (hi-en only)"]
  end
  subgraph MODEL[" "]
    direction LR
    SCOPE["Selected language and saved normalization"] --> ENCODER["Local compatible encoder"] --> BASE["Base prediction and task scores"]
  end
  subgraph OUTPUT[" "]
    direction LR
    SENT["Sentiment: positive, neutral, negative"] --> RESULT["Label, scores, source and warnings"]
    EMO["Emotion: joy, sadness, anger, fear, surprise, disgust, neutral"] --> RESULT
  end
  subgraph ADVANCED[" "]
    direction LR
    GATE["Implemented optional learned emoji gate architecture"]
    AUX["Optional context and sarcasm supervision requires reviewed labels"]
  end
  subgraph RESEARCH[" "]
    direction LR
    EVAL["File evaluation and model comparison"] --> DIAG["Disagreement and emoji / sarcasm diagnostics"] --> TOOLS["Calibration, ablations, conversation and optional local Qwen"]
  end
  subgraph HANDOFF[" "]
    direction LR
    REVIEW["Blind review and adjudication"] --> AUDIT["Hash-audited correction dataset"] --> ROLE["Train-only corrections; evaluation stays test"]
  end
  DATA --> INPUT --> MODEL --> OUTPUT --> RESEARCH --> HANDOFF
  OUTPUT -. optional variant .-> ADVANCED
  ADVANCED -. optional supervised branch .-> RESEARCH
